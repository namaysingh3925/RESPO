// Ember House — Phase 1 data model.
// Local dev: SQLite (prisma/dev.db). Production: switch provider to "postgresql"
// and turn MenuItem.dietaryTags into String[] (see docs/ARCHITECTURE.md §2).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  PAY_IN_PERSON
  CARD
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

/// Staff accounts now; optional customer accounts in Phase 2. Guests can book and order without one.
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  phone        String?
  /// Populated once auth ships in Phase 2.
  passwordHash String?
  role         UserRole      @default(CUSTOMER)
  reservations Reservation[]
  orders       Order[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String     @default("")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MenuItem {
  id          String      @id @default(cuid())
  slug        String      @unique
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  description String      @default("")
  /// Integer cents — never floats for money.
  priceCents  Int
  imageUrl    String
  /// Comma-separated DietaryTag values (String[] on PostgreSQL).
  dietaryTags String      @default("")
  calories    Int?
  isFeatured  Boolean     @default(false)
  isAvailable Boolean     @default(true)
  /// e.g. alcohol: listed on the menu, not orderable online.
  dineInOnly  Boolean     @default(false)
  sortOrder   Int         @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId, sortOrder])
}

model Reservation {
  id        String            @id @default(cuid())
  /// Short public reference, e.g. EH-7K3Q9P.
  code      String            @unique
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  phone     String
  partySize Int
  /// Restaurant-local calendar date, YYYY-MM-DD.
  date      String
  /// Restaurant-local slot start, HH:mm.
  time      String
  occasion  String?
  notes     String?
  status    ReservationStatus @default(CONFIRMED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([date, time])
  @@index([email])
}

model Order {
  id                   String             @id @default(cuid())
  /// Short public reference used for tracking, e.g. EH-4XK92M.
  code                 String             @unique
  userId               String?
  user                 User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  status               OrderStatus        @default(PENDING)
  fulfillment          FulfillmentType
  customerName         String
  email                String
  phone                String
  deliveryLine1        String?
  deliveryLine2        String?
  deliveryCity         String?
  deliveryPostalCode   String?
  deliveryInstructions String?
  /// Restaurant-local HH:mm for today; null = ASAP.
  requestedTime        String?
  notes                String?
  subtotalCents        Int
  taxCents             Int
  deliveryFeeCents     Int                @default(0)
  tipCents             Int                @default(0)
  totalCents           Int
  paymentMethod        PaymentMethod      @default(PAY_IN_PERSON)
  paymentStatus        PaymentStatus      @default(UNPAID)
  estimatedReadyAt     DateTime?
  items                OrderItem[]
  statusEvents         OrderStatusEvent[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model OrderItem {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  /// Snapshots — editing or deleting a menu item never rewrites past orders.
  menuItemSlug   String
  name           String
  unitPriceCents Int
  quantity       Int
  notes          String?
  lineTotalCents Int

  @@index([orderId])
}

/// Append-only audit trail that powers the order-tracking timeline.
model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}
