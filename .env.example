# Ember House — environment template. Copy to `.env` and fill in real values.

# SQLite for local development (relative paths resolve from the project root).
# Production (Postgres): postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="file:./prisma/dev.db"

# HTTP Basic auth credentials for /admin and /api/admin/*. Use a long random password.
# Staff access is denied when either value is missing.
ADMIN_USER="change-me"
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# "false" skips opening-hours checks for online orders (handy for local testing).
# Leave unset or "true" in production.
ENFORCE_BUSINESS_HOURS="true"

# Public site origin (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://www.example.com"
